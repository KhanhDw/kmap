# ============ App ============
ENV=development
DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost
BACKEND_ORIGIN=http://localhost

# ============ Database ============
POSTGRES_USER=kmap
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kmap
DATABASE_URL=postgresql+psycopg://kmap:change_me@db:5432/kmap

# ============ JWT ============
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============ Media ============
MEDIA_DIR=/data/media
MEDIA_URL_PREFIX=/media

# ============ Frontend (Vite — build-time) ============
VITE_API_URL=/api/v1
VITE_MAP_CENTER_LAT=10.8000
VITE_MAP_CENTER_LON=105.1500
VITE_MAP_ZOOM=12
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors

# ============ Tile (backend dùng ở M2) ============
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors

# ============ Admin seed (M4) ============
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!123
